{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "build",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
